# ---------------------------------------------------------------------------
# RK Campaign Intelligence Platform - root development environment template
# ---------------------------------------------------------------------------
# Copy to .env and adjust for your machine:
#   cp .env.example .env
#
# PostgreSQL is hosted on Neon. The database connection string belongs in
# apps/api/.env, NOT here - see apps/api/.env.example.
#
# This root file exists only for the OPTIONAL local Docker stack, which is a
# convenience for working offline. If you always use Neon, you do not need it.
#
# NEVER commit a real .env file or real credentials.
# ---------------------------------------------------------------------------

# --- Optional local PostgreSQL (docker compose service: postgres) ----------
# Used only by `npm run db:up`. These are throwaway local-only values.
POSTGRES_USER=rk_app
POSTGRES_PASSWORD=rk_local_dev_password
POSTGRES_DB=rk_campaign

# Host port for the containerised database.
# NOTE: 55432 is used instead of 5432 so the container never collides with a
# PostgreSQL already installed natively on the developer machine.
POSTGRES_PORT=55432

# --- Redis (placeholder service, NOT used by application code in Phase 1) ---
REDIS_PORT=56379
