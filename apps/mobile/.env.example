# ---------------------------------------------------------------------------
# @rk/mobile - environment template
#
#   cp .env.example .env
#
# Expo inlines every EXPO_PUBLIC_* variable into the JavaScript bundle, so it
# is readable by anyone with the app. NEVER put a secret or API key here.
# ---------------------------------------------------------------------------

# Absolute base URL of the API. No trailing slash.
#
# NOTE: "localhost" resolves to the device itself, not your development
# machine. Use your machine's LAN address for a physical device, or
# http://10.0.2.2:4000 for the Android emulator.
EXPO_PUBLIC_API_URL=http://localhost:4000

EXPO_PUBLIC_APP_NAME=RK Campaign
