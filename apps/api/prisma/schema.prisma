  coverImage       MediaAsset?        @relation("AchievementCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  verifiedBy       User?              @relation("AchievementVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  submittedBy      User?              @relation("AchievementSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
