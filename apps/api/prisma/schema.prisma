// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  locale         ContentLocale @default(en)
  slug           String        @db.VarChar(160)

  title            String          @db.VarChar(250)
  shortDescription String?         @db.VarChar(600)
  /// Sanitised HTML.
  descriptionHtml  String?
  category         ContentCategory @default(OTHER)
  area             String?         @db.VarChar(160)
  locationName     String?         @db.VarChar(250)
  latitude         Decimal?        @db.Decimal(9, 6)
  longitude        Decimal?        @db.Decimal(9, 6)

  startDate      DateTime? @db.Date
  completionDate DateTime? @db.Date

  projectStatus ProjectStatus @default(PLANNED)

  /// Phase 9 brought verification to projects, which had none.
  ///
  /// A completed road and a CLAIM that a road was completed are different
  /// things, and before this a project could say COMPLETED on the public site
  /// with nothing behind it. `projectStatus` is what the work is doing;
  /// `verification` is whether anybody checked. They are never derived from
  /// each other - COMPLETED does not imply VERIFIED, and that is the point.
  verification     VerificationStatus @default(UNVERIFIED)
  verifiedByUserId String?            @db.Uuid
  verifiedAt       DateTime?          @db.Timestamptz(6)

  submittedForReviewAt DateTime? @db.Timestamptz(6)
  submittedByUserId    String?   @db.Uuid
  assignedReviewerId   String?   @db.Uuid
  /// INTERNAL. Never in a public selection.
  rejectionReason      String?   @db.VarChar(2000)

  /// Who did the work. Displayed only when filled in; never inferred.
  department String? @db.VarChar(200)
  agency     String? @db.VarChar(200)

  /// Optional metrics. Never invented - absent means "not stated".
  costAmount       Decimal? @db.Decimal(14, 2)
  costCurrency     String?  @db.VarChar(3)
  beneficiaryCount Int?

  coverImageId String? @db.Uuid

  featured     Boolean       @default(false)
  displayOrder Int           @default(0)
  status       ContentStatus @default(DRAFT)
  publishedAt  DateTime?     @db.Timestamptz(6)

  metaTitle       String? @db.VarChar(200)
  metaDescription String? @db.VarChar(400)

  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  coverImage       MediaAsset?     @relation("ProjectCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  createdBy        User?           @relation("ProjectAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  verifiedBy       User?           @relation("ProjectVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  submittedBy      User?           @relation("ProjectSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  assignedReviewer User?           @relation("ProjectReviewer", fields: [assignedReviewerId], references: [id], onDelete: SetNull)
  media            ProjectMedia[]
  updates          ProjectUpdate[]
  evidence         WorkEvidence[]

  @@unique([organizationId, slug, locale])
  @@index([organizationId, status, publishedAt])
  @@index([organizationId, category, status])
  @@index([organizationId, featured, status])
  /// The verification queue and the transparency counters read exactly these.
  @@index([organizationId, verification, submittedForReviewAt])
  @@index([organizationId, status, projectStatus])
  @@map("projects")
}

/// Join between a project and the media library, carrying the image's role.
model ProjectMedia {
  id        String           @id @default(uuid()) @db.Uuid
  projectId String           @db.Uuid
  mediaId   String           @db.Uuid
  role      ProjectMediaRole @default(GALLERY)
  caption   String?          @db.VarChar(400)
  sortOrder Int              @default(0)

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([projectId, mediaId, role])
  @@index([projectId, role, sortOrder])
  @@map("project_media")
}

/// A dated progress note on a project.
model ProjectUpdate {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
