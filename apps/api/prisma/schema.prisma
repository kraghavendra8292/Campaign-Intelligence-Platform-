/// Supporting evidence for a claim.
///
/// TABLE NAME LAG: the table is still `achievement_evidence` because Phase 9
/// was required to be additive, and renaming a table is not. The Prisma model
/// was renamed because evidence now attaches to a project as well, and calling
/// it AchievementEvidence in code would mislead every future reader about what
/// it holds. The mismatch is deliberate and documented rather than hidden.
///
/// EXACTLY ONE OF achievementId / projectId IS SET. Enforced by a CHECK
/// constraint in the migration, not only in the service, because a service is
/// one refactor away from a second write path and a constraint is not.
///
/// isPublic gates publication of an individual item, and internalNote is NEVER
/// selected by the public API - staff need somewhere to record how a claim was
/// checked without that reasoning becoming a public statement.
model WorkEvidence {
  id            String  @id @default(uuid()) @db.Uuid
  achievementId String? @db.Uuid
  projectId     String? @db.Uuid

  /// Denormalised from the parent so evidence can be tenant-filtered without a
  /// join. Every query in the module filters on it; the join would otherwise be
  /// the only thing standing between a bug and cross-tenant evidence.
  organizationId String @db.Uuid

  title        String       @db.VarChar(250)
  description  String?      @db.VarChar(1000)
  evidenceType EvidenceType @default(OTHER)

  /// Public provenance, for example a municipal order reference.
  sourceNote   String? @db.VarChar(500)
  /// Staff-only. Excluded from every public selection.
  internalNote String? @db.VarChar(2000)
  documentId   String? @db.Uuid

  /// Document metadata. All optional: a photograph has no reference number,
  /// and demanding one would push staff to invent something.
  referenceNumber  String?   @db.VarChar(120)
  issuingAuthority String?   @db.VarChar(250)
  issuedOn         DateTime? @db.Date
  /// Caption, date and place for a photograph.
  capturedOn       DateTime? @db.Date
  capturedLocation String?   @db.VarChar(250)

  isPublic  Boolean @default(false)
  sortOrder Int     @default(0)

  uploadedByUserId String?  @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  achievement  Achievement? @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document     MediaAsset?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  uploadedBy   User?        @relation("EvidenceUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([achievementId, sortOrder])
  @@index([projectId, sortOrder])
  @@index([organizationId, isPublic])
  @@index([documentId])
  @@map("achievement_evidence")
}

/// One entry in a claim's verification history. Append-only.
///
/// WHY A TABLE RATHER THAN OVERWRITING THE STATUS. The status answers "what is
/// it now"; this answers "how did it get there", which is the question somebody
/// actually asks when a claim carries a badge. Submitted, rejected, evidence
/// revised, submitted again, verified is a story the status cannot tell, and
/// silently overwriting a rejection erases the one record showing that the
/// first attempt did not hold up.
///
/// `reason` is INTERNAL. It is never selected by any public query, and it is
/// never copied into audit metadata - the audit log is readable by everyone
/// with AUDIT_READ, which is a wider grant than EVIDENCE_READ.
model VerificationEvent {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  subjectType WorkSubjectType
  subjectId   String          @db.Uuid

  action     VerificationEventAction
  fromStatus VerificationStatus?
  toStatus   VerificationStatus?

  /// Internal. A rejection must carry one; other actions may.
  reason String? @db.VarChar(2000)

  actorUserId String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("VerificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, subjectType, subjectId, createdAt])
  @@index([organizationId, createdAt])
  @@map("verification_events")
}

