  @@index([organizationId, status, publishedAt])
  @@index([organizationId, category, status])
  @@index([organizationId, featured, status])
  /// The verification queue reads exactly this.
  @@index([organizationId, verification, submittedForReviewAt])
  @@map("achievements")
