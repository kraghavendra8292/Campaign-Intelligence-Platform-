// ---------------------------------------------------------------------------
// RK Campaign Intelligence Platform - database schema
//
// PHASE 2 SCOPE
// Identity, authentication, multi-tenancy, RBAC and audit. No business entity
// (candidates, content, projects, QR campaigns, feedback, issues) exists yet -
// those belong to Phase 3 and later.
//
// MULTI-TENANCY RULE
// Organization is the tenant root. Every business entity added from Phase 3
// onwards MUST carry `organizationId`, index it, and scope every query by it.
// Campaign is a sub-scope *within* an organisation, never a tenant of its own.
//
// DELETION RULE
// Security-relevant history is never cascade-deleted. Audit rows keep nullable,
// SetNull references to actors and tenants so revoking access or removing a
// tenant can never erase the record of what was done.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 no longer accepts a connection URL here. The CLI reads it from
// prisma.config.ts, and the runtime client receives it through the PrismaPg
// driver adapter in src/database/prisma.ts. One environment variable
// (DATABASE_URL) still feeds both.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Account lifecycle. Access is withdrawn by status, never by deletion, so
/// audit history keeps a valid actor reference.
enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("user_status")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED

  @@map("organization_status")
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("campaign_status")
}

/// PLATFORM roles are global (SUPER_ADMIN); ORGANIZATION roles are granted
/// through a membership in exactly one tenant.
enum RoleScope {
  PLATFORM
  ORGANIZATION

  @@map("role_scope")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// A tenant. One campaign / candidate organisation on the platform.
model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  /// URL-safe public identifier, for example "north-district-campaign".
  slug      String             @unique @db.VarChar(63)
  name      String             @db.VarChar(200)
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @db.Timestamptz(6)

  memberships OrganizationMembership[]
  campaigns   Campaign[]
  invitations Invitation[]
  auditLogs   AuditLog[]

  // Phase 3 content. Every one of these is tenant-owned.
  mediaAssets        MediaAsset[]
  candidateProfiles  CandidateProfile[]
  visions            Vision[]
  priorities         Priority[]
  projects           Project[]
  achievements       Achievement[]
  newsArticles       NewsArticle[]
  events             Event[]
  galleryAlbums      GalleryAlbum[]
  videoEntries       VideoEntry[]
  contactInformation ContactInformation[]
  socialLinks        SocialLink[]

  // Phase 4 QR campaigns. Tenant-owned like everything else.
  qrCampaigns  QrCampaign[]
  qrCodes      QrCode[]
  qrScanEvents QrScanEvent[]

  // Phase 5 citizen submissions.
  issueCategories     IssueCategory[]
  issues              Issue[]
  issueAttachments    IssueAttachment[]
  issueHistoryEntries IssueHistory[]
  issueNotes          IssueInternalNote[]

  // Homepage opinion pulse (Great / Ok / Worst).
  siteFeedback        SiteFeedback[]

  // Phase 6 AI intelligence. Derived from tenant data, so tenant-owned too:
  // cascading from the organisation is what guarantees an AI summary cannot
  // outlive the submission it describes.
  issueAiInsights      IssueAiInsight[]
  issueAiTopics        IssueAiTopic[]
  issueThemes          IssueTheme[]
  aiExecutiveSummaries AiExecutiveSummary[]
  aiUsageLogs          AiUsageLog[]

  // Phase 8 citizen communication. Tenant-owned like everything else.
  issuePublicUpdates IssuePublicUpdate[]
  issueSubscriptions IssueSubscription[]
  issueNotifications IssueNotification[]
  issueFollowUps     IssueFollowUp[]

  // Phase 9 verified work.
  workEvidence       WorkEvidence[]
  verificationEvents VerificationEvent[]

  @@index([status])
  @@map("organizations")
}

/// A campaign inside an organisation. A sub-scope, never a tenant boundary:
/// every campaign query must still be filtered by organizationId.
model Campaign {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  slug           String         @db.VarChar(63)
  name           String         @db.VarChar(200)
  status         CampaignStatus @default(DRAFT)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  CampaignMembership[]

  /// Slugs are unique per tenant, not globally: two organisations may both
  /// have a "ward-5" campaign.
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("campaigns")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// A platform user.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  /// Canonical (trimmed, lower-cased) email. The login identifier.
  email        String     @unique @db.VarChar(320)
  /// Argon2id digest. NEVER selected into a GraphQL type.
  passwordHash String?    @db.VarChar(255)
  fullName     String     @db.VarChar(200)
  status       UserStatus @default(INVITED)

  /// Invalidates access tokens issued before this instant. Bumped on password
  /// change and on global revocation, so a stolen access token stops working
  /// without waiting for it to expire.
  tokenValidFrom DateTime @default(now()) @db.Timestamptz(6)

  lastLoginAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  memberships         OrganizationMembership[]
  campaignMemberships CampaignMembership[]
  platformRoles       PlatformRoleAssignment[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  invitationsSent     Invitation[]             @relation("InvitationCreatedBy")
  invitationAccepted  Invitation[]             @relation("InvitationAcceptedBy")
  auditLogs           AuditLog[]               @relation("AuditActor")

  // Phase 3 authorship. All SetNull, so removing a user never deletes content.
  uploadedMedia        MediaAsset[]   @relation("MediaUploader")
  authoredProjects     Project[]      @relation("ProjectAuthor")
  authoredNews         NewsArticle[]  @relation("NewsAuthor")
  verifiedAchievements Achievement[]  @relation("AchievementVerifier")
  uploadedEvidence     WorkEvidence[] @relation("EvidenceUploader")

  // Phase 9. SetNull like every other authorship relation, and for the Phase 6
  // reason sharpened further: these record who ATTESTED that a public claim is
  // supported by evidence. The attribution must outlive the reviewer leaving,
  // because the organisation still stands behind the badge.
  verifiedProjects      Project[]           @relation("ProjectVerifier")
  submittedProjects     Project[]           @relation("ProjectSubmitter")
  reviewingProjects     Project[]           @relation("ProjectReviewer")
  submittedAchievements Achievement[]       @relation("AchievementSubmitter")
  reviewingAchievements Achievement[]       @relation("AchievementReviewer")
  verificationEvents    VerificationEvent[] @relation("VerificationActor")

  // Phase 4 authorship. SetNull for the same reason: removing a user must not
  // delete a QR code that is already printed on a poster.
  createdQrCampaigns QrCampaign[] @relation("QrCampaignCreatedBy")
  createdQrCodes     QrCode[]     @relation("QrCodeCreatedBy")

  // Phase 5. All SetNull: a citizen's report and the record of how it was
  // handled must outlive the staff member who handled it.
  assignedIssues      Issue[]             @relation("IssueAssignee")
  issueHistoryActions IssueHistory[]      @relation("IssueHistoryActor")
  issueNotesAuthored  IssueInternalNote[] @relation("IssueNoteAuthor")
  siteFeedback        SiteFeedback[]      @relation("SiteFeedbackSubmitter")

  // Phase 6. SetNull as well, and for a sharper reason than authorship: these
  // record who APPROVED model output. That attribution must survive the
  // reviewer leaving, because the organisation still stands behind what they
  // approved - but it must not hold the account open.
  aiInsightsReviewed   IssueAiInsight[]     @relation("AiInsightReviewer")
  aiThemesReviewed     IssueTheme[]         @relation("AiThemeReviewer")
  aiSummariesGenerated AiExecutiveSummary[] @relation("AiSummaryAuthor")
  aiSummariesReviewed  AiExecutiveSummary[] @relation("AiSummaryReviewer")
  aiUsage              AiUsageLog[]         @relation("AiUsageActor")

  // Phase 8. SetNull for the same reason as every other authorship relation:
  // the record of what a citizen was told must outlive the staff member who
  // told them, but must not hold their account open.
  publicUpdatesAuthored  IssuePublicUpdate[] @relation("PublicUpdateAuthor")
  publicUpdatesPublished IssuePublicUpdate[] @relation("PublicUpdatePublisher")
  followUpsReviewed      IssueFollowUp[]     @relation("FollowUpReviewer")

  @@index([status])
  @@map("users")
}

/// A named role. The stable `key` is the authorization identifier; `name` is a
/// display label and must never be used for an authorization decision.
model Role {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique @db.VarChar(50)
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  scope       RoleScope @default(ORGANIZATION)
  /// Privilege rank. An actor may only grant a role ranked strictly below
  /// their own highest rank, which bounds privilege escalation.
  rank        Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  permissions         RolePermission[]
  memberships         OrganizationMembership[]
  campaignMemberships CampaignMembership[]
  platformAssignments PlatformRoleAssignment[]
  invitations         Invitation[]

  @@index([scope])
  @@map("roles")
}

/// A single capability. Authorization is evaluated on these, never on roles.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(64)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Grant of a PLATFORM-scoped role (SUPER_ADMIN). Kept separate from
/// organisation memberships so a global grant can never be created by writing
/// a tenant-scoped row, and so it is independently auditable.
model PlatformRoleAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([userId])
  @@map("platform_role_assignments")
}

/// Binds a User to an Organization with a Role. The seam that makes the
/// platform multi-tenant: one user may belong to several organisations with a
/// different role in each.
model OrganizationMembership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  roleId         String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  /// A user holds at most one role per organisation.
  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_memberships")
}

/// Optional narrower scope within an organisation.
model CampaignMembership {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @db.Uuid
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
  @@map("campaign_memberships")
}

// ---------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------

/// A refresh-token session.
///
/// Only the SHA-256 digest of the refresh token is stored, so a database leak
/// does not yield usable credentials. `rotatedAt` + `replacedById` form a token
/// family: presenting an already-rotated token is replay, and revokes the whole
/// family rather than just failing.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  /// SHA-256 of the refresh token. Unique so a digest cannot be shared.
  refreshTokenHash String    @unique @db.VarChar(64)
  /// Groups every rotation of one login, so replay can revoke the lineage.
  familyId         String    @db.Uuid
  expiresAt        DateTime  @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  lastUsedAt       DateTime  @default(now()) @db.Timestamptz(6)
  rotatedAt        DateTime? @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  /// Why the session ended: LOGOUT, ROTATED, REPLAY, PASSWORD_CHANGE, ADMIN.
  revokedReason    String?   @db.VarChar(50)
  replacedById     String?   @db.Uuid

  /// Coarse client metadata for session review. No credentials.
  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(500)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A single-use password reset grant. Only the token digest is stored.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  requestedIp String? @db.VarChar(45)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// A single-use invitation into an organisation. Only the digest is stored.
model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  email          String    @db.VarChar(320)
  roleId         String    @db.Uuid
  tokenHash      String    @unique @db.VarChar(64)
  expiresAt      DateTime  @db.Timestamptz(6)
  acceptedAt     DateTime? @db.Timestamptz(6)
  revokedAt      DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  createdByUserId  String? @db.Uuid
  acceptedByUserId String? @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("InvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
  @@index([expiresAt])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only record of security-relevant actions.
///
/// No update or delete path exists in application code. References are
/// nullable + SetNull so removing a user or tenant cannot erase the history of
/// what they did. `metadata` is redacted before write - it must never contain a
/// password, token digest, cookie or authorization header.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  /// Null for platform-level events that belong to no single tenant.
  organizationId String?  @db.Uuid
  campaignId     String?  @db.Uuid
  /// Null when the actor is anonymous, e.g. a failed login.
  actorUserId    String?  @db.Uuid
  action         String   @db.VarChar(64)
  entityType     String?  @db.VarChar(64)
  entityId       String?  @db.VarChar(64)
  /// Sanitised, non-sensitive context.
  metadata       Json?
  ipAddress      String?  @db.VarChar(45)
  userAgent      String?  @db.VarChar(500)
  correlationId  String?  @db.VarChar(128)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// PHASE 3 - Public candidate website + CMS
//
// PUBLISHING RULE
// ContentStatus.PUBLISHED is the only status the public API returns. Every
// other status is CMS-only and requires CONTENT_READ_UNPUBLISHED.
//
// TRANSLATIONS
// Content rows carry a `locale` and are keyed (organizationId, slug, locale).
// A Kannada translation is therefore a sibling ROW sharing the slug, not a
// column on the English one - so each locale publishes independently and a
// half-finished translation can never leak onto the live site.
//
// TENANCY
// Every model below carries organizationId, indexes it, and is queried through
// it. Slugs are unique PER TENANT, never globally.
// ---------------------------------------------------------------------------

/// Editorial lifecycle. Distinct from domain status and from verification.
enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED

  @@map("content_status")
}

/// Domain lifecycle of a development project.
enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED

  @@map("project_status")
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED

  @@map("event_status")
}

/// Whether staff have checked a claim. Separate from publishing on purpose.
///
/// Phase 9 added REJECTED. Without it a reviewer who found the evidence
/// insufficient had to set the claim back to UNVERIFIED, which is
/// indistinguishable from "nobody has looked yet" - so the next reviewer began
/// from scratch and whoever submitted it was never told anything.
enum VerificationStatus {
  UNVERIFIED
  IN_REVIEW
  VERIFIED
  REJECTED

  @@map("verification_status")
}

/// Shared taxonomy across projects, achievements and news.
enum ContentCategory {
  INFRASTRUCTURE
  EDUCATION
  HEALTHCARE
  WATER
  AGRICULTURE
  EMPLOYMENT
  PUBLIC_SERVICES
  ENVIRONMENT
  OTHER

  @@map("content_category")
}

enum ContentLocale {
  en
  kn

  @@map("content_locale")
}

enum MediaKind {
  IMAGE
  DOCUMENT
  VIDEO_LINK

  @@map("media_kind")
}

enum VideoPlatform {
  YOUTUBE
  VIMEO
  OTHER

  @@map("video_platform")
}

// ---------------------------------------------------------------------------
// Phase 9 - verified work and evidence
// ---------------------------------------------------------------------------

/// Which kind of record a piece of evidence or a verification decision is about.
///
/// A discriminated subject rather than a third "work" table. Phase 3 already
/// models a work (Project) and a claimed accomplishment (Achievement); a third
/// entity spanning both would have duplicated whichever it resembled more and
/// left the public site with two answers to "what work was done here?".
enum WorkSubjectType {
  PROJECT
  ACHIEVEMENT

  @@map("work_subject_type")
}

/// What kind of artefact a piece of evidence is.
///
/// A DESCRIPTION, NOT AN ASSERTION OF AUTHORITY. Recording GOVERNMENT_ORDER
/// says a staff member believes the document is one; it does not make the
/// public badge claim government endorsement, and no code path treats any type
/// as self-authenticating. A forged work order and a real one are the same
/// value here, which is exactly why a person decides verification.
enum EvidenceType {
  OFFICIAL_DOCUMENT
  WORK_ORDER
  COMPLETION_CERTIFICATE
  GOVERNMENT_ORDER
  OFFICIAL_LETTER
  BEFORE_PHOTO
  DURING_PHOTO
  AFTER_PHOTO
  PROJECT_PHOTO
  PRESS_DOCUMENTATION
  PUBLIC_RECORD
  OTHER

  @@map("evidence_type")
}

/// What happened to a claim's verification. Written once, never updated.
enum VerificationEventAction {
  SUBMITTED_FOR_REVIEW
  REVIEWER_ASSIGNED
  REVIEW_STARTED
  VERIFIED
  REJECTED
  VERIFICATION_WITHDRAWN
  EVIDENCE_CHANGED

  @@map("verification_event_action")
}

/// How an image is used by a project.
enum ProjectMediaRole {
  GALLERY
  BEFORE
  AFTER

  @@map("project_media_role")
}

// ---------------------------------------------------------------------------
// Media library
// ---------------------------------------------------------------------------

/// An uploaded file or an external video reference.
///
/// Bytes live behind a storage abstraction (storageKey); this row is metadata
/// only. checksumSha256 is recorded so a duplicate upload is detectable and a
/// stored object can be integrity-checked.
model MediaAsset {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  kind           MediaKind
  /// Opaque key for the storage adapter. Never a client-supplied path.
  storageKey     String    @db.VarChar(512)
  /// Original client filename, kept for display only - never used as a path.
  originalName   String    @db.VarChar(255)
  mimeType       String    @db.VarChar(127)
  sizeBytes      Int
  checksumSha256 String?   @db.VarChar(64)
  width          Int?
  height         Int?
  altText        String?   @db.VarChar(300)
  caption        String?   @db.VarChar(500)

  uploadedByUserId String?  @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation("MediaUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  candidateProfileImages CandidateProfile[] @relation("CandidateProfileImage")
  candidateCoverImages   CandidateProfile[] @relation("CandidateCoverImage")
  priorityImages         Priority[]
  projectCovers          Project[]          @relation("ProjectCover")
  projectMedia           ProjectMedia[]
  achievementCovers      Achievement[]      @relation("AchievementCover")
  achievementMedia       AchievementMedia[]
  evidenceDocuments      WorkEvidence[]
  newsCovers             NewsArticle[]      @relation("NewsCover")
  eventCovers            Event[]            @relation("EventCover")
  albumCovers            GalleryAlbum[]     @relation("AlbumCover")
  albumItems             GalleryItem[]
  videoThumbnails        VideoEntry[]       @relation("VideoThumbnail")

  @@index([organizationId, kind])
  @@index([organizationId, createdAt])
  @@map("media_assets")
}

// ---------------------------------------------------------------------------
// Candidate profile, vision, priorities
// ---------------------------------------------------------------------------

/// The public profile of the candidate. One row per tenant per locale.
model CandidateProfile {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  locale         ContentLocale @default(en)

  fullName          String            @db.VarChar(200)
  displayName       String?           @db.VarChar(200)
  designation       String?           @db.VarChar(200)
  /// Plain text. Rendered as text, never as HTML.
  shortBio          String?           @db.VarChar(600)
  /// Sanitised HTML. Written only through the sanitiser.
  fullBioHtml       String?
  /// Sanitised HTML.
  experienceHtml    String?
  /// Sanitised HTML.
  publicServiceHtml String?
  focusAreas        ContentCategory[]

  profileImageId String? @db.Uuid
  coverImageId   String? @db.Uuid

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @db.Timestamptz(6)

  metaTitle       String? @db.VarChar(200)
  metaDescription String? @db.VarChar(400)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profileImage MediaAsset?  @relation("CandidateProfileImage", fields: [profileImageId], references: [id], onDelete: SetNull)
  coverImage   MediaAsset?  @relation("CandidateCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)

  @@unique([organizationId, locale])
  @@index([organizationId, status])
  @@map("candidate_profiles")
}

/// The vision statement. One row per tenant per locale.
model Vision {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  locale         ContentLocale @default(en)

  headline      String  @db.VarChar(300)
  /// Sanitised HTML.
  statementHtml String?
  summary       String? @db.VarChar(600)

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @db.Timestamptz(6)

  metaTitle       String? @db.VarChar(200)
  metaDescription String? @db.VarChar(400)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, locale])
  @@index([organizationId, status])
  @@map("visions")
}

