{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node", "vitest/globals"],
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": [
    "src/**/*.ts",
    "prisma/**/*.ts",
    "tsup.config.ts",
    "vitest.config.ts",
    "prisma.config.ts"
  ],
  "exclude": ["node_modules", "dist", "src/generated"]
}
