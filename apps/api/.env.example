# ---------------------------------------------------------------------------
# @rk/api - environment template
#
#   cp .env.example .env
#
# Every variable below is validated at startup by src/config/env.ts. A missing
# or malformed value stops the process with a message naming the variable.
#
# NEVER commit a real .env file. The placeholders below are not credentials.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database - Neon (hosted PostgreSQL)
# ---------------------------------------------------------------------------
# Get both strings from the Neon console (Connect) or `neon connection-string`.
#
#   DATABASE_URL           POOLED   - hostname CONTAINS  "-pooler"
#   DATABASE_URL_UNPOOLED  DIRECT   - hostname OMITS     "-pooler"
#
# Why two: the pooled endpoint runs PgBouncer in transaction mode, which does
# not preserve session state. That is correct for application queries and wrong
# for schema migrations - Prisma Migrate over a pooled connection fails with
# errors like `prepared statement "s0" already exists`. Migrations and seeding
# use the direct string; the running API uses the pooled one.
#
# TLS: use sslmode=verify-full. The `pg` driver currently treats `require` as
# full verification but that changes in pg v9, so state it explicitly and keep
# the strong behaviour. channel_binding=require protects against MITM relay.

DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.us-east-2.aws.neon.tech/rk_campaign?sslmode=verify-full&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/rk_campaign?sslmode=verify-full&channel_binding=require

# Client-side connection pool size. Small on purpose: Neon's pooled endpoint
# already fronts PgBouncer, so a large local pool only consumes your budget.
# Must exceed the widest single request's fan-out. The analytics services issue
# up to 15 aggregates concurrently for one dashboard answer, so a pool of 10 -
# the pre-Phase-10 default - could not serve one request without queueing
# against itself, and produced intermittent 500s under load.
DATABASE_POOL_MAX=25

# Health-probe timeout. Generous because Neon suspends idle computes, so the
# first query after a quiet period pays a cold-start penalty.
DATABASE_PROBE_TIMEOUT_MS=10000

# --- Local PostgreSQL alternative (optional) -------------------------------
# To work offline against the Docker container instead (`npm run db:up`),
# comment out the two Neon URLs above and uncomment this single line.
# No sslmode is needed because the connection never leaves your machine.
# DATABASE_URL=postgresql://rk_app:rk_local_dev_password@localhost:55432/rk_campaign?schema=public

# --- HTTP server -----------------------------------------------------------
GRAPHQL_PORT=4000
HOST=0.0.0.0

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Logging ---------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Colourised human-readable logs. Defaults to true outside production.
LOG_PRETTY=true

# --- GraphQL ---------------------------------------------------------------
# Serves the GraphQL IDE and enables introspection.
# Defaults to true outside production; MUST be false in production.
GRAPHQL_INTROSPECTION=true

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Number of reverse proxies in front of this service. Keep 0 unless deployed
# behind a load balancer, otherwise clients can spoof their IP address.
TRUST_PROXY_HOPS=0

# ---------------------------------------------------------------------------
# Authentication (Phase 2)
# ---------------------------------------------------------------------------
# Signing key for access tokens. NO DEFAULT EXISTS: a fallback secret would
# eventually reach a deployment, and a public JWT secret lets anyone mint a
# token for any user. Generate one per environment:
#   openssl rand -base64 48
JWT_SECRET=

JWT_ISSUER=rk-campaign-api
JWT_AUDIENCE=rk-campaign-clients

# Access tokens are short-lived because they cannot be revoked individually.
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh sessions are revocable and rotate on every use.
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_RESET_TTL_SECONDS=3600
INVITATION_TTL_SECONDS=604800

# --- Refresh cookie (browser clients) --------------------------------------
# MUST be true in production - startup refuses to boot otherwise.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
# Leave unset for a host-only cookie, which is the safest default.
# COOKIE_DOMAIN=

# Base URL used to build password-reset links.
PUBLIC_WEB_URL=http://localhost:5173

# --- Password policy -------------------------------------------------------
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=256

# --- Authentication rate limiting ------------------------------------------
# NOTE: the default limiter is in-memory and does NOT coordinate across
# instances. A Redis-backed store is required before horizontal scaling.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_PASSWORD_RESET_MAX_ATTEMPTS=5
AUTH_REFRESH_MAX_ATTEMPTS=60

# DEVELOPMENT ONLY: writes password-reset and invitation links to the log so
# they can be followed without email infrastructure. Configuration validation
# REFUSES this in production - it would put live bearer tokens in your logs.
AUTH_DEV_EXPOSE_TOKENS=false

# ---------------------------------------------------------------------------
# Seed-only bootstrap administrator
# ---------------------------------------------------------------------------
# SUPER_ADMIN cannot be granted through a tenant membership, so the first one
# is created by the seed. Both variables are required; without them the seed
# creates roles and permissions and skips the admin. Never commit a real value.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=Platform Administrator

# --- Public site and CMS (Phase 3) -----------------------------------------
# Local directory for uploaded media. NOT suitable for production: it does not
# survive a container restart and is not shared between instances. Replace the
# storage adapter with an S3-compatible one before deploying.
MEDIA_STORAGE_PATH=var/media

# Absolute base URL of the public site, used for canonical and Open Graph URLs.
PUBLIC_SITE_URL=http://localhost:5173

# --- QR campaigns (Phase 4) ------------------------------------------------
# Origin that serves the public scan endpoint (GET /q/:code). This value is
# ENCODED INTO EVERY PRINTED QR SYMBOL, so changing it after codes have been
# printed breaks them permanently. Separate from PUBLIC_SITE_URL because the
# scan endpoint lives on the API while the destination page lives on the web app.
#
# Local development: the API itself.
# Production with the Cloudflare /q proxy: the SAME origin as PUBLIC_SITE_URL
#   (e.g. https://campaign-intelligence-platform.youragency.workers.dev)
# Production without the proxy: the public API origin (e.g. https://api.example.com)
# On Render, if unset, RENDER_EXTERNAL_URL is used automatically.
QR_SCAN_BASE_URL=http://localhost:4000

# Rate limit for the public scan endpoint. Deliberately generous: a public
# meeting or classroom scanning one poster from behind a single NAT is
# legitimate traffic and must not be throttled.
QR_SCAN_RATE_LIMIT_WINDOW_MS=60000
QR_SCAN_RATE_LIMIT_MAX=600

# Whether to compute the daily, salted, non-reversible visit hash used to
# estimate repeat scans within one day. With this off no hash is stored at all
# and the unique estimate is reported as unavailable rather than as zero.
QR_UNIQUE_ESTIMATION=true

# Documented retention policy for individual scan rows. Phase 4 does NOT run a
# deletion job; this is the value a future retention task will read.
QR_SCAN_RETENTION_DAYS=400

# --- Citizen submissions (Phase 5) -----------------------------------------
# These budgets protect an endpoint open to the whole internet, and each is a
# trade-off against a real person trying to report a real problem. They are
# deliberately loose: a household, a classroom or an internet cafe behind one
# NAT must never be blocked, so they stop scripts rather than neighbours.
ISSUE_SUBMIT_WINDOW_MS=600000
ISSUE_SUBMIT_MAX_PER_WINDOW=10
ISSUE_UPLOAD_MAX_PER_WINDOW=30

# Reference lookups are limited much more tightly. The reference space is
# already too large to brute force; this makes the attempt not worth starting.
ISSUE_TRACK_WINDOW_MS=300000
ISSUE_TRACK_MAX_PER_WINDOW=20

# --- AI issue intelligence (Phase 6) ---------------------------------------
# The assistant is OFF by default and the whole phase is optional. With
# AI_ENABLED=false the admin console reports AI as unavailable, no provider is
# ever constructed, and - the part that matters - citizen submission is
# completely unaffected, because it never depended on any of this.
AI_ENABLED=false

# Which adapter serves requests: "openai" or "mock".
# "mock" returns deterministic, clearly-labelled placeholder output. It lets the
# entire admin console, review workflow and dashboard be exercised in
# development without a provider account or a single paid call. Production
# configuration REFUSES "mock", because placeholder text shown to an
# administrator as though it were analysis is worse than no feature at all.
AI_PROVIDER=mock

# Provider credential. SERVER-SIDE ONLY.
# Never commit a real key. There is deliberately no VITE_-prefixed twin: the
# browser has no path to a provider and is not meant to have one. The key is
# never written to a database column, never returned in a GraphQL response and
# never logged.
OPENAI_API_KEY=
# Override for Azure OpenAI or a compatible gateway.
OPENAI_BASE_URL=https://api.openai.com/v1

# Model identifier, as configuration rather than a literal in business logic.
# Recorded on every generation so output from an older model stays attributable
# after this value changes.
AI_MODEL=gpt-4o-mini

# Output ceiling per call. Every operation returns a short structured object,
# not an essay, so this bounds cost without constraining the result.
AI_MAX_TOKENS=900

# Sampling temperature. Deliberately low: these are administrative summaries of
# what a citizen actually wrote, and the desirable property is faithfulness to
# the source rather than variety. A higher value buys nothing and makes
# invention more likely.
AI_TEMPERATURE=0.2

# Per-request timeout. A hung provider must not hold a queue slot.
AI_TIMEOUT_MS=30000

# Retries for TRANSIENT failures only (timeout, 429, 5xx). Invalid output is
# never retried: a model that returned unparseable JSON will usually do it
# again, and the useful response is to surface it for review rather than pay
# for the same failure three times.
AI_MAX_RETRIES=2

# Whether a new submission is queued for processing automatically. The enqueue
# is fire-and-forget, made AFTER the submission is committed and the citizen
# already has their reference number, and is a no-op when AI is disabled.
AI_AUTO_PROCESS_ON_SUBMIT=true

# In-process worker concurrency and backlog ceiling. The queue runs inside the
# API process (see aiQueue.ts for why that is a documented limitation rather
# than an architecture), so one worker keeps provider concurrency predictable.
AI_QUEUE_CONCURRENCY=1
AI_QUEUE_MAX_SIZE=500

# Generation budget per ORGANISATION per window. Tenant-scoped rather than
# per-user because the cost lands on the tenant: three administrators each
# regenerating politely still adds up to one bill. Regeneration carries a
# tighter ceiling because it is the one operation that is otherwise unbounded.
AI_RATE_LIMIT_WINDOW_MS=3600000
AI_RATE_LIMIT_MAX_PER_ORG=300
AI_REGENERATE_MAX_PER_ORG=50

# Per-million-token rates for the ESTIMATED cost column. Deliberately unset by
# default: a default price would be a guess that renders as a dollar figure in
# an admin dashboard. Unpriced usage reports as "Not priced" rather than as
# "$0.00". Set these to the rates your account actually pays.
AI_COST_PER_MILLION_INPUT_USD=
AI_COST_PER_MILLION_OUTPUT_USD=

# --- Citizen communication (Phase 8) ---------------------------------------
# The OUTBOUND channel is off by default and the whole phase is optional. With
# NOTIFICATIONS_ENABLED=false the platform still records consent, still shows
# citizens their status page, and still publishes staff updates to it - what it
# does not do is quietly pretend to send mail nobody receives.
NOTIFICATIONS_ENABLED=false

# Which adapter delivers email: "log" or "smtp".
# "log" writes the message to the server log and marks it SENT. It is how a
# developer, and a deployment that has not yet bought an email service,
# exercises the whole follow-up loop without a provider account. Production
# configuration REFUSES it, because a dashboard reporting "SENT" for messages
# that went to a log file converts a missing feature into a false record.
#
# NOTE: the SMTP adapter is DECLARED BUT NOT IMPLEMENTED in this build. It
# fails loudly with NOT_CONFIGURED rather than silently succeeding. Implementing
# it is one method plus a mail dependency; everything around it - queue, retry,
# idempotency, templates, delivery tracking, dashboard - is finished.
EMAIL_PROVIDER=log

# Envelope sender. Required before anything can be sent for real.
EMAIL_FROM=
EMAIL_FROM_NAME=Campaign office

# SMTP transport. No defaults; all three are required when EMAIL_PROVIDER=smtp.
# Never commit a real password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Per-send timeout. A hung provider must not hold a queue worker.
NOTIFICATION_TIMEOUT_MS=15000

# Base URL for the links inside a message. Separate from PUBLIC_SITE_URL for the
# same reason QR_SCAN_BASE_URL is: getting it wrong means emailing citizens a
# link that does not resolve.
NOTIFICATION_LINK_BASE_URL=http://localhost:5173

# Public-endpoint budgets, in the spirit of the Phase 5 submission limits: loose
# enough that a household behind one NAT is never blocked, tight enough to stop
# a script. Follow-up is tighter because it WRITES, and because a citizen has
# one genuine follow-up to give per submission rather than twenty.
FOLLOW_UP_WINDOW_MS=3600000
FOLLOW_UP_MAX_PER_WINDOW=10
SUBSCRIPTION_WINDOW_MS=3600000
SUBSCRIPTION_MAX_PER_WINDOW=20

# Ceiling on outbound messages per submission per day. The protection a citizen
# actually needs from this feature: without it, a staff member editing a status
# ten times in an afternoon emails somebody ten times about one pothole.
NOTIFICATION_MAX_PER_ISSUE_PER_DAY=6

# In-process worker concurrency and backlog ceiling. The queue runs inside the
# API process - see the limitations section of the Phase 8 docs.
NOTIFICATION_QUEUE_CONCURRENCY=1
NOTIFICATION_QUEUE_MAX_SIZE=1000

# ---------------------------------------------------------------------------
# Phase 10 - production hardening
# ---------------------------------------------------------------------------

# Ceilings on how much work ONE GraphQL document may ask for.
#
# Rate limits cap how many requests arrive and pagination caps how many rows a
# field returns; neither caps a single deeply nested request. /graphql is
# reachable unauthenticated because the public site is served through it, so
# that gap was exploitable with one request and no credentials.
#
# Both are enforced during VALIDATION, so an abusive document is rejected before
# any resolver runs and before the database is touched. Lower them under attack
# without a deploy; raise them only with a measured reason.
#
# Depth 12 admits the deepest real query (public work detail, ~6) with room for
# fragments. Cost 5000 admits the analytics dashboard, which fans out widest.
GRAPHQL_MAX_DEPTH=12
GRAPHQL_MAX_COST=5000
