# ---------------------------------------------------------------------------
# @rk/web - environment template
#
#   cp .env.example .env
#
# WARNING: every VITE_ variable is compiled into the browser bundle and is
# publicly readable. NEVER put a secret, API key or database credential here.
# ---------------------------------------------------------------------------

# Absolute base URL of the API. No trailing slash.
VITE_API_URL=http://localhost:4000

# Product name shown in the header and page chrome.
VITE_APP_NAME=RK Campaign

# Language a first-time visitor sees on the public site: kn (default) or en.
# A returning visitor keeps whatever they last chose in the language selector.
VITE_DEFAULT_LOCALE=kn

# Tenant rendered when the URL carries no ?org= parameter and the host has no
# site subdomain. Required for local development, where "localhost" has no
# subdomain to resolve a candidate site from.
VITE_DEFAULT_SITE_SLUG=demo-campaign
